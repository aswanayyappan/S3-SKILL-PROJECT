# Port for the Node.js server
PORT=3000

# Groq API Key (Get yours from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# FreeTheAI API Configuration (GLM-5.3 Model Gateway)
FTAI_API_KEY=ftai_your_key_here
FTAI_MODEL=fta/zai/glm-5.3

# Firebase Realtime Database URL
FIREBASE_DB_URL=https://s3-skills-default-rtdb.firebaseio.com/

# Optional: Firebase Database Secret or Auth Token if rules require authentication
FIREBASE_AUTH_SECRET=

