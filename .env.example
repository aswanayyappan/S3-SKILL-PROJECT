# ========================================================
# S-3 IOT ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION)
# ========================================================

# 1. Server Port (Render sets this automatically; defaults to 3000 locally)
PORT=3000

# 2. FreeTheAI API Configuration (GLM-5.3 Model Gateway)
# Active FreeTheAI Key provided for the project:
FTAI_API_KEY=ftai_0b81473d41ee2a05ee2636d115e14951468f542016ce1337
FTAI_MODEL=fta/zai/glm-5.3-flash

# 3. Groq API Configuration (Optional - for LLaMA 3.3 70B & 8B)
# Get a free key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Firebase Realtime Database
FIREBASE_DB_URL=https://s3-skills-default-rtdb.firebaseio.com/
FIREBASE_AUTH_SECRET=

# 5. Tariff Billing & Continuous Machine Learning Settings
TARIFF_RATE_PER_UNIT=8.00
LEARNING_INTERVAL_MINUTES=5
